# ==========================================
# Variables d'environnement requises
# ==========================================
# Copiez ce fichier en .env.local et remplissez les valeurs

# GitHub Personal Access Token
# Requis pour les composants GithubContributions et GitHubProjects
# Créer un token sur https://github.com/settings/tokens
# Scopes nécessaires : read:user, public_repo
GITHUB_TOKEN_USER_DATA=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==========================================
# Variables optionnelles (Vercel)
# ==========================================

# Ces variables sont automatiquement injectées par Vercel en production
# VERCEL_URL=
# VERCEL_ENV=
